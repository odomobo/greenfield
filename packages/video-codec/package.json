{
  "name": "@nebula/video-codec",
  "version": "0.1.0",
  "description": "The video codec: frames in, H.264 out. The GStreamer encoder (native/, its own addon, reading frames of @nebula/frames), the pool of warm encoder instances, and encoder detection.",
  "type": "commonjs",
  "private": true,
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types",
    "native"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "build:native": "mkdir -p build && cmake -G Ninja -B./build -S./native && ninja -C ./build install",
    "build": "npm run build:native && npx tsc -b",
    "test": "node --test --test-force-exit dist/test/",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@nebula/frames": "*",
    "@nebula/session-contracts": "*"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "20.14.8",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.2",
    "typescript": "~5.5.2"
  },
  "license": "AGPL-3.0-or-later"
}
