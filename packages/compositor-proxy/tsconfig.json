{
  "extends": "@tsconfig/node18/tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowJs": true,
    "rootDirs": ["src"],
    "pretty": true,
    "declarationDir": "types",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
  },
  "exclude": ["dist", "types", "build", "native", ".eslintrc.js", ".prettierrc.js"]
}
