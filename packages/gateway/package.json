{
  "name": "@gfld/gateway",
  "version": "0.1.0",
  "description": "The per-user desktop session process, and the static files of the page (served by the Rust web front in packages/login).",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "build": "yarn run rimraf dist && yarn run tsc && node dist/build-dconf.js && node dist/build-audio.js",
    "test": "node --test --test-force-exit dist/test/",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@gfld/compositor-proxy": "workspace:^",
    "@gfld/scene-protocol": "workspace:^",
    "dbus-next": "^0.10.2",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "^20.14.8",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.2"
  },
  "license": "AGPL-3.0-or-later"
}
