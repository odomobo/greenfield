{
  "extends": "@tsconfig/node18/tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowJs": true,
    "rootDirs": ["src"],
    "pretty": true,
    "declarationDir": "types",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "strict": true
  },
  "references": [
    { "path": "../session-contracts" },
    { "path": "../congestion" },
    { "path": "../scheduler" },
    { "path": "../patch-codec" },
    { "path": "../video-codec" },
    { "path": "../transport" }
  ],
  "exclude": ["dist", "types", "build", "native", ".eslintrc.js", ".prettierrc.js"]
}
