{
  "name": "@gfld/session",
  "version": "0.1.0",
  "description": "The per-user desktop session: Wayland compositor (wlroots), frame encoding, transport, shell service, audio.",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "build:native": "mkdir -p build && cmake -G Ninja -B./build -S./ && ninja -C ./build install",
    "build:typescript": "npx tsc -b",
    "build": "rm -rf dist types && npm run build:native && npx tsc -b",
    "test": "node --test --test-force-exit dist/encoding/test/ dist/wlroots/test/ dist/viewer/test/ dist/test/",
    "watch": "npm run build && npx tsc -b -w",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@gfld/scene-protocol": "*",
    "@nebula/frames": "*",
    "@nebula/session-contracts": "*",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "20.14.8",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.2",
    "typescript": "~5.5.2"
  },
  "license": "AGPL-3.0-or-later"
}
