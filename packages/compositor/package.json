{
  "name": "@gfld/compositor",
  "version": "1.0.0-rc1",
  "description": "Wayland compositor core, runs server-side inside a session process.",
  "keywords": [
    "linux",
    "wayland",
    "typescript",
    "compositor",
    "remote"
  ],
  "files": [
    "dist-server"
  ],
  "scripts": {
    "build": "yarn run tsc --noEmit && yarn run build:server",
    "build:server": "yarn run esbuild src/server/index.ts --bundle --platform=node --format=esm --sourcemap --outfile=dist-server/index.mjs"
  },
  "dependencies": {
    "@gfld/common": "workspace:^",
    "@gfld/compositor-protocol": "workspace:^",
    "@gfld/compositor-wasm": "workspace:^"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "esbuild": "0.21.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.2",
    "typescript": "^5.5.2"
  },
  "author": "Erik De Rijcke",
  "homepage": "https://www.greenfield.app",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/udevbe/greenfield/tree/master/packages/compositor"
  }
}
